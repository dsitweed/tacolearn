// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

generator nestjsDto {
  provider                      = "prisma-generator-nestjs-dto"
  output                        = "../src/generated/nestjs-dto"
  reExport                      = "true"
  generateFileTypes             = "entity"
  exportRelationModifierClasses = "false"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  role     UserRole @default(USER)
  isActive Boolean  @default(true)

  // Profile information
  profile UserProfile?

  // Auth: server-side sessions & linked providers (credential / Google OAuth)
  sessions Session[]
  accounts Account[]

  // Notifications
  notifications Notification[]

  deletedAt DateTime? // softDelete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([id, role])
  @@index([role])
  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String?
  avatar      String? // key to avatar image in bucket
  dateOfBirth DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

// Auth: server-side session store (refresh tokens, device/IP tracking, revocation)
model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique // opaque/refresh token (store a hash in production)
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// Auth: linked authentication providers per user (credential + OAuth like Google)
model Account {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerId String // 'credential' | 'google' | ...
  accountId  String // the provider's user id (or this user's id for credential)

  password              String?   @db.VarChar(255) // hash, only for providerId = 'credential'
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Auth: short-lived tokens for email verification, password reset, magic link, OTP
model Verification {
  id         String   @id @default(uuid())
  identifier String // email / userId / purpose key (e.g. "reset:user@mail.com")
  value      String // token or OTP (store a hash in production)
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Generic notification system
model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    NotificationType @default(SYSTEM)

  isRead Boolean   @default(false)
  readAt DateTime?

  // Optional reference to related entity
  relatedId   String?
  relatedType RelatedEntityType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@map("notifications")
}

// Enums
enum UserRole {
  ADMIN
  USER
}

enum NotificationType {
  ANNOUNCEMENT
  SYSTEM
}

enum RelatedEntityType {
  BILL
  PAYMENT
  RENTAL
  MAINTENANCE_REQUEST
  MESSAGE
  ROOM
  BUILDING
}
